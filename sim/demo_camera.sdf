<?xml version="1.0"?>
<!-- Fixed overhead camera used only to record the demo GIF.
     Looks straight down at the centre of turtlebot3_world. -->
<sdf version="1.8">
  <model name="demo_camera">
    <static>true</static>
    <link name="link">
      <!-- Pose on the link: ros_gz_sim create overrides the model pose. -->
      <pose>0 0 4.6 0 1.5708 0</pose>
      <sensor name="demo_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>5</update_rate>
        <topic>demo_camera/image</topic>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>720</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.1</near><far>20</far></clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
